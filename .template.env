in_scope=["^(?:[\\w-]+\\.)*example\\.com$",".*"]
out_scope=[]
exclude_path=[]
user_agent_suffix=test-agent
include_headers=[["X-Test","testheader"]]
remove_headers=["sec-ch-ua-platform"]
remove_cookies=[]
cdp_port=9222
cdp_host="127.0.0.1"
cdp_poll_interval=2.0
cdp_timeout=10.0
cdp_max_reconnect_delay=30.0
cdp_reconnect_timeout=2.0
cdp_auto_launch=true
cdp_user_data_dir=~/.config/google-chrome-debug
